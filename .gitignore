# Dependencies
node_modules/
# npm lockfile SEMPRE versionado (ENGENHARIA §16.2 "Build e Dependências"):
# `npm ci` em CI exige package-lock.json, e sem ele o build deixa de ser
# reprodutível. NUNCA adicionar `package-lock.json` abaixo.
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# Environment variables - NEVER commit
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local

# Secrets and keys
.jwt_secret
*.pem
*.key
*.cert
*.p12
*.pfx

# Local database files
# Regra numa linha, comentário noutra: o Git NÃO aceita comentário inline numa
# regra de ignore — `cookies.txt  # texto` casa com o nome inteiro e nunca
# ignora nada. Foi exatamente o que deixou o ficheiro versionado.
cookies.txt
estufa.db
*.sqlite
*.sqlite3

# Firmware ESP32 (contem credenciais WiFi/ThingSpeak/DEVICE_TOKEN) - nunca versionar
*.ino
# Projeto PlatformIO do firmware: ignora-se o diretorio INTEIRO porque
# `src/main.cpp` tem as mesmas credenciais do .ino (WiFi, ThingSpeak, e o token
# do dispositivo). Versiona-lo foi exactamente o que a v1.1.0 teve de reverter
# ("security: remove leaked secrets") — a regra passa a ser uma so.
# Consequencia: `include/secrets.h.example` tambem fica fora do Git; ele existe
# no disco local como modelo. (Nao se usa `!` para o re-incluir: o Git nao
# re-inclui ficheiro dentro de um diretorio excluido.)
260929-*/
# Segredos locais do firmware (token do dispositivo, ADR-0007/0008).
include/secrets.h
**/include/secrets.h

# Build outputs
dist/
build/
release/
out/
.next/
*.exe
*.msi
*.dmg
*.apk
*.aab
*.ipa

# Electron release builds
release/*/win-unpacked/
release/*/*.blockmap
release/*/builder-debug.yml
release/*/builder-effective-config.yaml

# Mobile build artifacts (Capacitor/Android)
mobile/*/android/
mobile/*/ios/
mobile/*/node_modules/
mobile/*/package-lock.json

# TWA (Android/Trusted Web Activity) gerado pelo Bubblewrap
# Versiona-se APENAS `twa/twa-manifest.json` (a "receita" reproduzível do APK).
# O projeto Android, o keystore e os binários assinados sao gerados no CI
# (.github/workflows/android-twa.yml) e NUNCA entram no Git.
# (O `android.keystore` da raiz tambem fica fora: foi onde o artefacto do CI
# caiu numa sessao anterior — o sitio certo e a pasta Downloads, fora do repo.)
android.keystore
twa/app/
twa/android.keystore
twa/manifest-checksum.txt
twa/twa-manifest.json.backup
twa/app-release-*
twa/*.apk
twa/*.aab
# Scratch de sessao (downloads de artefactos do CI, backups --bare, espelhos
# de release): ficheiros que so existem durante o trabalho e nao pertencem ao
# versionamento.
.tmp/


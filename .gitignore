# Dependencies
node_modules/
# npm lockfile SEMPRE versionado (ENGENHARIA §16.2 "Build e Dependências"):
# `npm ci` em CI exige package-lock.json, e sem ele o build deixa de ser
# reprodutível. NUNCA adicionar `package-lock.json` abaixo.
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# Environment variables - NEVER commit
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local

# Secrets and keys
.jwt_secret
*.pem
*.key
*.cert
*.p12
*.pfx

# Local database files
# Regra numa linha, comentário noutra: o Git NÃO aceita comentário inline numa
# regra de ignore — `cookies.txt  # texto` casa com o nome inteiro e nunca
# ignora nada. Foi exatamente o que deixou o ficheiro versionado.
cookies.txt
estufa.db
*.sqlite
*.sqlite3

# Firmware ESP32 (contem credenciais WiFi/ThingSpeak) - nunca versionar
*.ino

# Build outputs
dist/
build/
release/
out/
.next/
*.exe
*.msi
*.dmg
*.apk
*.aab
*.ipa

# Electron release builds
release/*/win-unpacked/
release/*/*.blockmap
release/*/builder-debug.yml
release/*/builder-effective-config.yaml

# Mobile build artifacts (Capacitor/Android)
mobile/*/android/
mobile/*/ios/
mobile/*/node_modules/
mobile/*/package-lock.json

# IDE and editor files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini


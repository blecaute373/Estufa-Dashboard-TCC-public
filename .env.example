# ThingSpeak
TS_CHANNEL=SEU_CHANNEL_ID_AQUI
TS_API_KEY=SUA_API_KEY_AQUI

# MongoDB (MongoDB Atlas - free tier: https://mongodb.com)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/estufa

# Servidor
PORT=3000

# Broker MQTT local (server.js → Mosquitto na rede da estufa)
LOCAL_MQTT_BROKER=mqtt://192.168.0.6:1883

# ── Controlo remoto via fila de comandos na Vercel (ADR-0007 + ADR-0008) ───
# A Vercel e serverless e nao alcanca a rede local: o painel grava o comando
# na fila (Upstash Redis) e o ESP32 recolhe-o em GET /api/control/pending a
# cada 10 s. Sem DEVICE_TOKEN o endpoint responde 401 (fail-closed) e nada e
# aplicado. Gere um valor aleatorio e longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=cole-aqui-o-token-do-dispositivo-32-bytes-hex

# Identificador do dispositivo (tem de coincidir com ID_ESTUFA no firmware)
DEVICE_ID=estufa01

# ── Upstash Redis: a fila de comandos (ADR-0008) ───────────────────────────
# Crie uma base gratuita em https://console.upstash.com e copie a string de
# conexao. OBRIGATORIA em producao: sem ela a fila nao funciona e o
# `lib/store.js` falha logo com mensagem explicita (fail-fast, sem fallback).
#
# Uma unica variavel com endpoint E token. Formatos aceites (o `lib/config.js`
# extrai o token e passa-o ao SDK):
#   https://SEU-ENDPOINT.upstash.io/?_token=SEU_TOKEN
#   https://SEU_TOKEN@SEU-ENDPOINT.upstash.io
#
# ATENCAO: este token NUNCA vai para o firmware nem para o browser. Vive so no
# ambiente da Vercel. O ESP32 conhece apenas DEVICE_TOKEN.
# Plano gratis verificado: 500K comandos/mes, 256 MB, 1 base.
REDIS_URL=https://SEU-ENDPOINT.upstash.io/?_token=SEU_TOKEN

# JWT (OBRIGATÓRIO em produção — sem fallback; dev gera efémero com aviso)
JWT_SECRET=gere-com-openssl-rand-hex-64

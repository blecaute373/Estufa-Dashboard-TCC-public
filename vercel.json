{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*.!(html)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/dashboard.html", "dest": "/api/index.js" },
    { "src": "/admin.html", "dest": "/api/index.js" },
    { "src": "/index.html", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/index.js" },
    { "src": "/(.*\\.(css|js|png|jpg|ico|svg|woff2?|ttf|eot))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
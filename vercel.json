{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/assetlinks.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*.!(html)",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "/api/assetlinks.js"
    },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/login-dashboard.html", "dest": "/api/index.js" },
    { "src": "/login-admin.html", "dest": "/api/index.js" },
    { "src": "/dashboard.html", "dest": "/api/index.js" },
    { "src": "/admin.html", "dest": "/api/index.js" },
    { "src": "/index.html", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/index.js" },
    { "src": "/(.*\\.(css|js|json|png|jpg|ico|svg|woff2?|ttf|eot))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
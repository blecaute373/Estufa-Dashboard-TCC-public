{
  "name": "estufa-monitor",
  "version": "1.0.0",
  "description": "Estufa 01 — Monitor com autenticação segura",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron-dashboard": "cross-env APP_URL=http://localhost:3000 electron electron-dashboard.js",
    "electron-admin": "cross-env APP_URL=http://localhost:3000 electron electron-admin.js",
    "build-dashboard-win": "electron-builder build --config build-dashboard.json --win",
    "build-admin-win": "electron-builder build --config build-admin.json --win",
    "build-all": "npm run build-dashboard-win && npm run build-admin-win"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.0.3"
  }
}
{
  "appId": "com.estufa.admin",
  "productName": "Estufa 01 - Admin",
  "directories": {
    "output": "release/admin"
  },
  "files": [
    "electron-admin.js",
    "public/**/*"
  ],
  "extraMetadata": {
    "main": "electron-admin.js"
  },
  "win": {
    "target": "nsis",
    "artifactName": "Estufa-Admin-Setup.${ext}"
  },
  "nsis": {
